athJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="2dd08469-ad03-464c-8184-8f8499ad282d" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="202c5218-ca55-4e52-ae27-01ade05bd1e6"><mjx-mi class="mjx-i" data-ref="98a41e6c-842f-41f3-bd91-53e6f2464db5"><mjx-c class="mjx-c1D458 TEX-I" data-ref="53e92db3-55e2-43d6-a2ca-df89ac13cf7b"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="7812e623-a646-4b59-9d47-9f4573586eca"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="117f8b3a-66e0-4eab-ac55-3800c39b0771"><mi data-ref="8078e200-f205-4752-8db4-77a66f9d7620">k</mi></math></mjx-assistive-mml></mjx-container> deletions of the root element.</li></ul><p data-ref="520cb1ed-52dc-4cae-99cd-3cc8be913dc0" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="2d0c1624-e26d-424b-9a1b-d9fdc85d7a07"></p><p data-ref="c6db6a6c-3daf-4b5b-8b85-41148ae88816" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="44b87202-fadf-456c-88b0-45fcd58753d6">Note:</strong> Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="9c952fd6-3446-4c4d-9117-b2f635e65e63"><div class="ml-1 mb-3" data-ref="be344b15-8feb-406e-8ed1-b74a843046ba"><b style="border-bottom:1px solid black;" data-ref="ba0a9d7a-6cf2-4f09-bdcb-df909c1d5cf2" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="8b064b4a-9402-4ff7-af0a-20039419b186" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="4d295e64-42e0-4e29-868e-59589f500121" data-undisplayed="undisplayed">maxheap.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="96b3a3ff-7bba-486a-af65-067adf0ecca4" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#define MAX_SIZE 1000
int heap[MAX_SIZE];
int size=0;
void swap(int *a,int *b){
	int t=*a;
	*a=*b;
	*b=t;
}
void heapifyUp(int index){
	while(index&gt;0 &amp;&amp; heap[(index-1)/2]&lt;heap[index]){
		swap(&amp;heap[index],&amp;heap[(index-1)/2]);
		index=(index-1)/2;
	}
}
void insert(int value){
	heap[size]=value;
	heapifyUp(size);
	size++;
}
void heapifyDown(int index){
	int largest=index;
	int left = 2*index+1;
	int right = 2*index+2;
	if(left &lt; size &amp;&amp; heap[left]&gt;heap[largest])
		largest=left;
	if(right &lt; size &amp;&amp; heap[right]&gt;heap[largest])
		largest=right;
	if(largest!=index){
		swap(&amp;heap[index],&amp;heap[largest]);
		heapifyDown(largest);
	}
}
void deletemax(){
	if(size==0)
		return;
	heap[0]=heap[size-1];
	size--;
	heapifyDown(0);
}
void printheap(){
	int i;
	for(i=0;i&lt;size;i++){
		printf("%d ",heap[i]);
	}
}
int main(){
	int n,i,value,delcount;
	scanf("%d",&amp;n);
	for(i=0;i&lt;n;i++){
		scanf("%d",&amp;value);
		insert(value);
	}
	printheap();
	scanf("%d\n",&amp;delcount);
	for(i=0;i&lt;delcount;i++){
		deletemax();
	}
	printheap();
	printf("\n");
	return 0;
}
