4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="321f3398-e9f2-4c1b-8150-0ccaa2ad430b"></p><p data-ref="e28bc983-e175-4690-835d-f7208e1b6116" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="6e5423de-d3d8-460e-8c2f-4444cd93d4b4">Input Format:</strong></p><ul data-ref="b1498715-ff6a-4b51-9726-e97dc8207aa4" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="47390b07-065e-4667-bbc0-49af0bbce33a">The input begins with a line containing two integers <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="b463e44b-407b-4e41-a11f-9476ec587f68" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="e25be4b9-ec1d-41d7-ba74-de919796ca17"><mjx-mi class="mjx-i" data-ref="e3ccf87e-f8e0-4ab6-8b10-5408e0dcf102"><mjx-c class="mjx-c1D449 TEX-I" data-ref="7ccf1d46-48f9-4265-a97d-63145036944d"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="165e6887-9a04-4f63-a366-e2912aceb660"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="fd3185a6-7ba7-4aaf-ab04-48db82831a5a"><mi data-ref="4adf4cea-490f-4dfb-90a7-80d102fe3be6">V</mi></math></mjx-assistive-mml></mjx-container> and <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="1b99669a-2ea1-43be-b1b5-4eb64f4fc8b2" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="67dafd5e-5f74-41bd-bd2a-161d31a1af0d"><mjx-mi class="mjx-i" data-ref="49750207-225b-4ddf-b399-e0605cd05de3"><mjx-c class="mjx-c1D438 TEX-I" data-ref="af724ae9-194f-4695-971c-d04e610d3531"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="2350a704-0e7c-4887-80b7-43441a34f3d3"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="ed308046-394d-480e-8ba9-01f3efe83339"><mi data-ref="361d0017-9a27-4e51-8d4e-f6068b10d253">E</mi></math></mjx-assistive-mml></mjx-container>, where <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="d82ad4ae-f797-4492-abc8-189ee888c10d" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="20454ac6-bff2-4e6e-bc90-78c1a851667e"><mjx-mi class="mjx-i" data-ref="73714e2b-f88c-4754-ad42-bd4f74a994e7"><mjx-c class="mjx-c1D449 TEX-I" data-ref="39bd36d0-006c-4c8d-9533-6da9867571ab"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="8290d3b8-053e-42f1-b156-4fb97defee8a"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="87ce9bd1-04fc-4df5-a957-10c2fd658c2b"><mi data-ref="726b6377-eae8-4605-b4c0-63f6ff8cf80c">V</mi></math></mjx-assistive-mml></mjx-container> is the number of vertices and <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="cdf94696-bcbb-4764-a7f9-2a6d8fb8c60a" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="9c72867e-9209-48df-b3be-b70411952c62"><mjx-mi class="mjx-i" data-ref="d4c9a2b1-e77b-404f-96e8-9fe34eac1260"><mjx-c class="mjx-c1D438 TEX-I" data-ref="7cdb44f2-b630-4f1f-9364-98f22f2e0cc1"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="6c6ff91a-7730-4a