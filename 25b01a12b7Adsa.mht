div class="ml-1 mb-3" data-ref="b6d54bd8-013c-465f-8899-683eb49c830c"><b style="border-bottom:1px solid black;" data-ref="653d08d3-3069-4540-9d74-89e372a98234" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="cf523c75-3135-475a-964d-5074fbdc09f3" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="ebc36902-1a7a-4bbc-be02-2275d18009b9" data-undisplayed="undisplayed">minheap.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="49a77397-df95-45b5-9bb9-e45a9c9d548f" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#define MAX_SIZE 1000
int heap[MAX_SIZE];
int size=0;
void swap(int* a,int* b){
	int t=*a;
	*a=*b;
	*b=t;
}
void heapifyUp(int i){
	while(i&gt;0 &amp;&amp; heap[(i-1)/2]&gt;heap[i]){
		swap(&amp;heap[i],&amp;heap[(i-1)/2]);
		i = (i-1)/2;
	}
}
void insert(int value){
	heap[size]=value;
	heapifyUp(size);
	size++;
}
void heapifyDown(int i){
	int smallest=i;
	int l=2*i+1;
	int r=2*i+2;
	if(l&lt;size &amp;&amp; heap[l]&lt;heap[smallest])
		smallest=l;
	if(r&lt;size &amp;&amp; heap[r]&lt;heap[smallest])
		smallest=r;
	if(smallest!=i){
		swap(&amp;heap[i], &amp;heap[smallest]);
		heapifyDown(smallest);
	}
}
void deleteMin(){
	if(size==0) return;
	heap[0]=heap[size-1];
	size--;
	heapifyDown(0);
}
void printHeap(){
	int i;
	for(i=0;i&lt;size;i++){
		printf("%d ",heap[i]);
	}
}
int main(){
	int n,i,value,delCount;
	scanf("%d",&amp;n);
	for(i=0;i&lt;n;i++){
		scanf("%d",&amp;value);
		insert(value);
	}
	printHeap();
	scanf("%d\n",&amp;delCount);
	for(i=0;i&lt;delCount;i++){
		deleteMin();
	}
	printHeap();
	printf("\n");
	return 0;
}</pre><br data-ref="1c9cddfa-3bbd-40b2-8576-6f7cd2e14a8d"></div></div><div class="row" data-ref="9c7e6edc-abc6-41d3-b14f-311443a18fc1"><div class="col-12" data-ref="61353255-7b7f-48da-bdad-ec14149457aa"><h5 class="execResultsHeading text-center" data-ref="88ce1b3c-4b96-4d4c-ba33-5c4ab27b3a43">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="9a32a3ad-f07b-43d2-94a3-fd487b12a662" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="30578aa9-05cc-4fb0-ad09-a4f7c2562ee9"><div class="row execution-results-border" data-ref="86af0431-06c9-473b-b5b3-409614bbb7be"><div class="col-12 p-2 text-center font-weight-bold" data-ref="9eb7d4e9-ff4d-4330-9c66-0f141659e737">Test Case - 1</div></div><div class="row execution-results-border" data-ref="0666fdf0-2871-4788-86e8-75452eaac4d3"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="50391e39-f4de-4551-8bcf-1d1ec23ec9fd">User Output</div></div><div class="row execution-results-border" data-ref="d9865191-4c32-4bac-ab75-574ab0fa7ce8"><div class="col-6" data-ref="6e4994ad-4ed9-439a-a102-4bda4f07af4e"><span class="cmd" title="User Input" data-ref="e1d3519c-20a5-4c89-855d-dd674e048f7d">5</span></div></div><div class="row execution-results-border" data-ref="a93c59c6-ddea-4a18-80fc-5e269c40a628"><div class="col-6" data-ref="5ebca68d-0cb6-4936-b649-36e81d6ec97c"><span class="cmd" title="User Input" data-ref="57100f69-bd70-4dae-b41f-32f66971f5d8">20 15 30 5 10</span></div></div><div class="row execution-results-border" data-ref="f9b42b64-3580-4c96-95bb-351c9ef2eaf2"><div class="col-6" data-ref="e20d1863-9f9b-4bee-81f2-4e225fe8cbc5"><span class="cmd" title="User Input" data-ref="d8c73fe6-cd58-4969-b701-b77087d99818">2</span></div></div><div class="row execution-results-border" data-ref="92787149-28c0-4545-907d-82323dc2a1b1"><div class="col-12" data-ref="a067b3c3-297b-4068-889b-c4b43faba5b6"><pre class="outputPre" data-ref="48