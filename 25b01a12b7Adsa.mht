4340-9b9f-e43d03efb20d"><div class="ml-1 mb-3" data-ref="6898e83b-e8e9-49ff-80e3-01914bf8f6c8"><b style="border-bottom:1px solid black;" data-ref="52f45ff3-3873-4941-924e-03ebe21f7a14" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="a01345a5-ba3b-42d7-83cd-6162642200ec" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="beb20ef6-1024-4082-b36c-448913caa739" data-undisplayed="undisplayed">knapsackBacktracking.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="d0b71499-1be6-4b6b-af6d-5c1476c09fc0" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
int n;
int w;
int maxProfit = 0;
int value[100],weights[100];
void knapsack(int i,int currentweight,int currentvalue){
    if(i==n){
        if(currentvalue&gt;maxProfit)
            maxProfit=currentvalue;
        return;
    }
    if(currentweight+weights[i]&lt;=w){
        knapsack(i+1,currentweight+weights[i],currentvalue+value[i]);
    }
    knapsack(i+1,currentweight,currentvalue);
}
int main(){
    scanf("%d",&amp;n);
    for(int i=0;i&lt;n;i++)
        scanf("%d %d",&amp;value[i],&amp;weights[i]);
    scanf("%d",&amp;w);
    knapsack(0,0,0);
    printf("%d\n",maxProfit);
    return 0;
