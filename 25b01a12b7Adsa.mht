<div class="container-xl" data-ref="bc580ccf-4f4d-44ad-a14d-03f488bddf47"><header class="text-right" data-ref="a9fba00e-edb7-4b24-ad9c-a093af984511"> </header> <div class="page" data-ref="7b8ddc8f-0008-4875-9dbf-6d85dac98921"><div id="lab-print" data-ref="8151d565-cbec-4020-9dac-d5ec786d7916" data-id="lab-print"><div class="ct-print-new-page-after-always" data-ref="8b34bf79-4716-4d45-bdeb-5dd478f1210e" data-break-after="always"><div data-ref="12048f87-d280-4a1e-bece-d1e29a48ed14"><table class="table table-condensed table-bordered table-hover" data-ref="86b9bd33-8483-43db-91fe-efb6133e67ed"><thead data-ref="a7b8ba2e-c358-4118-83fc-392234faf3cd"><tr data-ref="1f31949a-fc81-4890-9107-be16ab28beb8"><th class="text-left align-middle" style="width:20%" data-ref="4ec7b523-e1b2-4ef8-8507-4d5b3f5f77c6" data-undisplayed="undisplayed">S.No: 1</th> <th class="text-left align-middle" style="width:55%; font-weight: normal;" data-ref="277986fe-8ca7-4935-ac5a-448bfa818ce5" data-undisplayed="undisplayed">Exp. Name: <b class="expTitle" data-ref="89767a5d-f9eb-4636-9660-8b50e06ad4bc"><i data-ref="819b51a7-d4d6-43de-a6af-3b15a5327fba">Program to implement AVL tree and its operations</i></b></th> <th class="text-left align-middle" style="width:25%" data-ref="e54bbd18-0148-4f36-9c8e-0a2395a963c4" data-undisplayed="undisplayed">Date: 2026-08-25</th></tr></thead></table></div><div class="ml-1" style="page-break-inside: auto" data-ref="7c1d746b-b422-4d0d-9021-3c758020f12c" data-undisplayed="undisplayed"><b style="border-bottom:1px solid black;" data-ref="f06b2512-aa2d-47c8-bf57-12fbe8736d72" data-undisplayed="undisplayed">Aim:</b><br data-ref="eb79b89f-04ae-4f6d-8898-56c8f7e1840b"> <span class="question-text ql-editor" data-ref="a7e1851c-1f3d-42fe-96cf-b02d3d1f9cb7"><p data-ref="5c0b1dcb-df12-469f-882d-c40635443a79" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0">Write a program to create an AVL tree using a provided set of elements stored in a file. Implement operations for inserting and deleting elements from the AVL tree. After constructing the tree, output the contents of the tree in in-order traversal to a new file.</p><p data-ref="95ffdb64-12df-43d6-beb6-81b6730a0760" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="a9a7170c-2df9-4cd8-a337-afa33db98ca8"></p><p data-ref="664797ec-6660-4ccb-9700-6648a11267db" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="2fdd727c-e5aa-4bf6-806c-dfe72632b464">Note: </strong>Refer to visible test cases for better understanding.</p></span></div><div class="mb-3" data-ref="fd906b50-fef0-4023-9050-3a27bee41b59"><div class="ml-1 mb-3" data-ref="aad49efa-e206-4a6f-bbf4-f81131010b98"><b style="border-bottom:1px solid black;" data-ref="e78a8050-b345-454c-b2e2-23c100575b55" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="28dfa5d5-155a-4b4d-8887-8a387ad4bb51" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="f93dac77-4d7d-45c0-8c52-4ddce9ce6e70" data-undisplayed="undisplayed">avl_tree.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="3e8af873-6d47-42a8-9198-d5e3378f0e8b" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#include &lt;string.h&gt;
#include &lt;stdbool.h&gt;
typedef struct Node {
    int key;
    struct Node* left;
    struct Node* right;
    int height;
} Node;
// Utility functions
int height(Node* N) {
    if (N == NULL) return 0;
    return N-&gt;height;
}
/*The max() function helps us find which subtree (left or right) is taller. Since the height of a node depends on the longest path from that node to a leaf, we take the maximum of the left and right subtree heights*/
int max(int a, int b) {
    return (a &gt; b) ? a : b;
}

Node* newNode(int key) {
    Node* node = (Node*)malloc(sizeof(Node));
    node-&gt;key = key;
    node-&gt;left = node-&gt;right = NULL;
    node-&gt;height = 1;
    return node;
}
//example insert 50(50 is key ,its height is initialized with 1)
// Rotations
//LL imbalance
Node* rightRotate(Node* y) {
    Node* x = y-&gt;left;
    Node* T2 = x-&gt;right;
    x-&gt;right = y;
    y-&gt;left = T2;
    y-&gt;height = max(height(y-&gt;left), height(y-&gt;right)) + 1;
    x-&gt;height = max(height(x-&gt;left), height(x-&gt;right)) + 1;
    return x;
}
Node* leftRotate(Node* x) {
    Node* y = x-&gt;right;
    Node* T2 = y-&gt;left;
    y-&gt;left = x;
    x-&gt;right = T2;
    x-&gt;height = max(height(x-&gt;left), height(x-&gt;right)) + 1;
    y-&gt;height = max(height(y-&gt;left), height(y-&gt;right)) + 1;
    return y;
}
int getBalance(Node* N) {
    if (N == NULL) return 0;
    return height(N-&gt;left) - height(N-&gt;right);
}
// Insert
Node* insert(Node* node, int key) {
    if (node == NULL)
        return newNode(key);
    if (key &lt; node-&gt;key)
        node-&gt;left = insert(node-&gt;left, key);
    else if (key &gt; node-&gt;key)
        node-&gt;right = insert(node-&gt;right, key);
    else
        return node; // No duplicates
    node-&gt;height = 1 + max(height(node-&gt;left), height(node-&gt;right));
    int balance = getBalance(node);
    // Balancing
//LL IMBALANCE
    if (balance &gt; 1 &amp;&amp; key &lt; node-&gt;left-&gt;key) return rightRotate(node);
//RR imbalance
    if (balance &lt; -1 &amp;&amp; key &gt; node-&gt;right-&gt;key) return leftRotate(node);
//LR IMBALANCE
    if (balance &gt; 1 &amp;&amp; key &gt; node-&gt;left-&gt;key) {
        node-&gt;left = leftRotate(node-&gt;left);
        return rightRotate(node);
    }
//RL IMBALANCE
    if (balance &lt; -1 &amp;&amp; key &lt; node-&gt;right-&gt;key) {
        node-&gt;right = rightRotate(node-&gt;right);
        return leftRotate(node);
    }
    return node;
}
// Minimum value node
Node* minValueNode(Node* node) {
    Node* current = node;
    while (current-&gt;left)
        current = current-&gt;left;
    return current;
}
// Delete
Node* deleteNode(Node* root, int key, int* found) {
    if (!root) return root;
    if (key &lt; root-&gt;key)
        root-&gt;left = deleteNode(root-&gt;left, key, found);
    else if (key &gt; root-&gt;key)
        root-&gt;right = deleteNode(root-&gt;right, key, found);
    else {
        *found = 1;
        if (!root-&gt;left || !root-&gt;right) {
            Node* temp = root-&gt;left ? root-&gt;left : root-&gt;right;
            if (!temp) {
                temp = root;
                root = NULL;
            } else
                *root = *temp;
            free(temp);
        } else {
            Node* temp = minValueNode(root-&gt;right);
            root-&gt;key = temp-&gt;key;
            root-&gt;right = deleteNode(root-&gt;right, temp-&gt;key, found);
        }
    }
    if (!root) return root;
    root-&gt;height = 1 + max(height(root-&gt;left), height(root-&gt;right));
    int balance = getBalance(root);
    if (balance &gt; 1 &amp;&amp; getBalance(root-&gt;left) &gt;= 0) return rightRotate(root);
    if (balance &gt; 1 &amp;&amp; getBalance(root-&gt;left) &lt; 0) {
        root-&gt;left = leftRotate(root-&gt;left);
        return rightRotate(root);
    }
    if (balance &lt; -1 &amp;&amp; getBalance(root-&gt;right) &lt;= 0) return leftRotate(root);
    if (balance &lt; -1 &amp;&amp; getBalance(root-&gt;right) &gt; 0) {
        root-&gt;right = rightRotate(root-&gt;right);
        return leftRotate(root);
    }
    return root;
}
// In-order traversal
void inorder(Node* root, FILE* out) {
    if (root) {
        inorder(root-&gt;left, out);
        fprintf(out, "%d ", root-&gt;key);
        inorder(root-&gt;right, out);
    }
}
void printInorder(Node* root) {
    FILE* temp = tmpfile();
    inorder(root, temp);
    rewind(temp);
    int x;
    while (fscanf(temp, "%d", &amp;x) == 1) {
        printf("%d ", x);
    }
    printf("\n");
    fclose(temp);
}
// Main Program
int main() {
    Node* root = NULL;
    char inputFile[20];
    printf("Input file name: ");
    scanf("%s", inputFile);
//lets say input file contains 10 20 30 40 50
    FILE* in = fopen(inputFile, "r");
    if (!in) {
        printf("Error opening input file\n");
        return 1;
    }
    int val;
	char line[256];
	fgets(line, sizeof(line), in);
	while (fscanf(in, "%d", &amp;val) != EOF)
        root = insert(root, val);
    fclose(in);
    printf("In-order traversal:\n");
    printInorder(root);
    int choice, key;
    while (1) {
        printf("1. Insert\n2. Delete\n3. Write to file and exit\nChoice: ");
        scanf("%d", &amp;choice);
        switch (choice) {
            case 1:
                printf("Element: ");
                scanf("%d", &amp;key);
                root = insert(root, key);
                printf("In-order traversal:\n");
                printInorder(root);
                break;
            case 2:
                printf("Element: ");
                scanf("%d", &amp;key);
                    int found = 0;
                    root = deleteNode(root, key, &amp;found);
                    if (found)
                        printf("Deleted %d\n", key);
                    else
                        printf("%d not found\n", key);
                    printf("In-order traversal:\n");
                    printInorder(root);
                    break;
            case 3:{
                    char outputFile[100];
                    printf("Output file name: ");
                    scanf("%s", outputFile);
                    FILE* out = fopen(outputFile, "w");
                    if (!out) {
                        printf("Error opening output file\n");
                        return 1;
                    }
                    inorder(root, out);
                    fprintf(out, "\n");
                    fclose(out);
                    printf("AVL Tree written to file\n");
                    return 0;}
                default:
                printf("Invalid choice\n");
        }
    }
}</pre><br data-ref="dbb9096c-984d-41af-8b03-5ce7ef89c4c9"></div><div class="user-solution" style="page-break-inside: auto" data-ref="4acff3e2-502e-4c7f-a8fe-3a24ca34ca54" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="05bbe05b-6e9a-4f7b-b050-407831e4ecae" data-undisplayed="undisplayed">input1.txt</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="e477cbc9-791d-4188-b6ea-8e3331bd1168" data-undisplayed="undisplayed">5
