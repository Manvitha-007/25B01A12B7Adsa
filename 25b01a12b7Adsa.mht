ata-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="17f6dc02-fda8-4251-9345-e6316af4b400"></p><p data-ref="b732eae1-0c9a-4fae-b692-1e92be178582" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="29245ec5-2557-431f-b7ce-da5594555d7c">﻿Note: </strong></p><ul data-ref="b32e525a-f42e-4a72-a47f-be3169b1c054" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="d367ddb9-8097-40cb-a0f0-f4d71e66046f">In DFS, the smaller numbered node is visited first when there are multiple adjacent nodes, ensuring a consistent traversal order</li><li data-ref="6e8c3f8f-ea6d-47e5-839b-3830bd0f0184">Refer to the visible test cases for a better understanding.</li></ul></span></div><div class="mb-3" data-ref="301a706c-c237-4d73-974e-372063e71531"><div class="ml-1 mb-3" data-ref="4bfbd229-6f55-43fe-97ca-dd7431bbbcba"><b style="border-bottom:1px solid black;" data-ref="5df481e7-7e32-4278-adcb-64dc1ba0c249" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="49f347db-f881-4d0d-acd3-c722d8229105" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="a1ae0a86-c2c8-44b8-9514-cf651a6de67d" data-undisplayed="undisplayed">dfs_directed_graph.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="e6fdbf13-c84a-43cb-94e0-2e996bd3eeb8" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#define MAX 100
// Adjacency list node
typedef struct Node{
    int vertex;
    struct Node*next;
} Node;
Node* adj[MAX];
int visited[MAX];
int n, e;
Node* createNode(int v){
    Node* newNode = (Node*)malloc(sizeof(Node));
    newNode-&gt;vertex = v;
    newNode-&gt;next = NULL;
    return newNode;
}
void insertSorted(int u, int v) {
    Node* newNode = createNode(v);
    if (adj[u] == NULL || adj[u]-&gt;vertex &gt; v) {
        newNode-&gt;next = adj[u];
        adj[u] = newNode;
    } else {
        Node* current = adj[u];
        while (current-&gt;next != NULL &amp;&amp; current-&gt;next-&gt;vertex &lt; v)
            current = current-&gt;next;
        newNode-&gt;next = current-&gt;next;
        current-&gt;next = newNode;
    }
}
void DFS(int v) {
    Node* temp;
    visited[v] = 1;
    printf("%d ", v);
    temp = adj[v];
    while (temp != NULL){
        if (!visited[temp-&gt;vertex])
        {
            DFS(temp-&gt;vertex);
        }
        temp = temp-&gt;next;
    }
}
int main(){
    int i, u, v, start;
    scanf("%d %d", &amp;n, &amp;e);
    for(i=0;i&lt;n;i++){
        visited[i] = 0;
        adj[i] = NULL;
    }
    for(i=0;i&lt;e;i++){
        scanf("%d %d", &amp;u, &amp;v);
        insertSorted(u,v);
    }
    scanf("%d", &amp;start);
    DFS(start);
    return 0;
}</pre><br data-ref="46e2a928-98ef-445c-865e-5ede47991de1"></div></div><div class="row" data-ref="7bedbbd2-1b95-4e3b-8f97-e19510303471"><div class="col-12" data-ref="aa6f5b10-99ac-4248-a4ff-7d1c1db93d5a"><h5 class="execResultsHeading text-center" data-ref="3595a78a-8ca5-4e87-816b-590c8fb1fd02">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="d0796bee-3165-47cd-9ff2-53dbe378a1c2" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="24538f92-3a2f-4e3a-9923-664cd1fca981"><div class="row execution-results-border" data-ref="9c39a7d4-d927-4ee1-b475-1d0bb4f7442f"><div class="col-12 p-2 text-center font-weight-bold" data-ref="036851ee-9bb7-4bb6-9ac1-c0a8a9988acf">Test Case - 1</div></div><div class="row execution-results-border" data-ref="913e73cc-0337-4fc7-80ea-42960fc4124a"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="38ad8cfa-5a26-489d-ad46-68ced1164c62">User Output</div></div><div class="row execution-results-border" data-ref="821373a4-e14d-4f54-87db-ec9dbb4e8497"><div class="col-6" data-ref="51db51ce-21b6-41ba-b0fa-3b731b37f3a6"><span class="cmd" title="User Input" data-ref="67100b8a-24b1-44ea-a337-45fbe44223ff">5 6</span></div></div><div class="row execution-results-border" data-ref="88856428-1c36-4168-bb39-91b833ff0748"><div class="col-6" data-ref="7fe7e96b-aa82-4641-8900-46b4e38ed03b"><span class="cmd" title="User Input" data-ref="c52ba76f-6d1a-430e-8f6b-93e17187b935">0 1</span></div></div><div class="row execution-results-border" data-ref="379d0ee4-056a-4062-8bd4-17dbd0e1b50b"><div class="col-6" data-ref="798e8e9f-fe39-4eb6-8b66-4e17a14307bd"><span class="cmd" title="User Input" data-ref="600844bb-026f-4a27-89c5-b3bed07eed36">0 2</span></div></div><div class="row execution-results-border" data-ref="0b71c1ad-c16e-4f16-bf80-1250268d65a0"><div class="col-6" data-ref="30cd2e87-7d49-408e-a459-3b55882bb6ab"><span class="cmd" title="User Input" data-