int n;
void DFS(int vertex){
	int i;
	visited[vertex]=1;
	printf("%d ",vertex);
	for(i=0;i&lt;n;i++){
		if(adj[vertex][i]==1 &amp;&amp; !visited[i]){
			DFS(i);
		}
	}
}
