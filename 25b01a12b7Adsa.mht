#define MAX 100
int main(){
	int n;
	scanf("%d",&amp;n);
	int id[MAX],deadline[MAX],profit[MAX];
	int i,j;
	for(i=0;i&lt;n;i++){
		scanf("%d %d %d",&amp;id[i], &amp;deadline[i], &amp;profit[i]);
	}
	for(i=0;i&lt;n-1;i++){
		for(j=i+1;j&lt;n;j++){
			if(profit[i]&lt;profit[j]){
				int temp;
				temp = profit[i];
				profit[i] = profit[j];
				profit[j] = temp;
				temp = deadline[i];
				deadline[i] = deadline[j];
				deadline[j] = temp;
				temp = id[i];
				id[i]=id[j];
				id[j]=temp;
			}
		}
	}
	
	int slot[MAX] = {0};
	int jobDone=0,maxprofit=0;
	for(i=0;i&lt;n;i++){
		for(j=deadline[i];j&gt;0;j--){
			if(slot[j]==0){
				slot[j]=1;
				jobDone++;
				maxprofit=maxprofit+profit[i];
				break;
			}
		}
	}
	printf("%d %d\n",jobDone,maxprofit);
	return 0;
}</pre><br data-ref="94f82acd-c655-4c2a-a1f5-6aaf475c0ee6"></div></div><div class="row" data-ref="f7e43d21-540b-4bc1-9d4e-394b0feb77fb"><div class="col-12" data-ref="b0ef3c44-7513-4e2c-825f-40ee5198a976"><h5 class="execResultsHeading text-center" data-ref="1be566c7-b681-49f6-9d4f-fb3abb174d42">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="4bc7d262-f566-4e08-be8e-9d024a244f31" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="69889436-3702-49ab-8920-56375c330c1c"><div class="row execution-results-border" data-ref="b8420e9a-ce7c-4d36-ac0a-ff538e0a80df"><div class="col-12 p-2 text-center font-weight-bold" data-ref="45df6863-f6b8-4a90-bf4d-fcd4d36aecc3">Test Case - 1</div></div><div class="row execution-results-border" data-ref="bb67c8d1-3fab-4ea9-bdc5-06b01f9def9b"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="9d76f748-035b-4b65-a8c8-cd3d31c9aabe">User Output</div></div><div class="row execution-results-border" data-ref="b0bdd761-f2a8-41df-8a30-1edc9ae1317b"><div class="col-6" data-ref="daf5ff4f-b39b-4206-8a9d-93d37e99dfb9"><span class="cmd" title="User Input" data-ref="151b7d15-7acc-4a44-ac5b-0d63bf0ac855">4</span></div></div><div class="row execution-results-border" data-ref="82dc6ace-812c-4a2f-9e9c-a9e55db3ba70"><div class="col-6" data-ref="e198726b-0b29-477c-8016-b96fa7ed4727"><span class="cmd" title="User Input" data-ref="bf68d277-58d9-4486-b67a-fc045629b3ca">1 4 20</span></div></div><div class="row execution-results-border" data-ref="fbf19d6c-651c-49e8-8eb8-93343f3e3f0e"><div class="col-6" data-ref="96bb7a6f-24e4-430f-b65f-b83f3bb58e6d"><span class="cmd" title="User Input" data-ref="f1c6888b-0625-4657-b72c-4cf77febbfe3">2 1 10</span></div></div><div class="row execution-results-border" data-ref="8af699ee-4287-4fe0-9205-708d3e4e07ee"><div class="col-6" data-ref="06660061-e370-4843-bb9f-433f2ac182a9"><span class="cmd" title="User Input" d