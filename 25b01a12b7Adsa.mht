void quickSort(int arr[],int low,int high);
int partition(int arr[],int low,int high);
int main(){
	int n;
	scanf("%d",&amp;n);
int arr[n];
	for(int i=0;i&lt;n;i++){
		scanf("%d",&amp;arr[i]);
	}
	quickSort(arr,0,n-1);
	for(int i=0;i&lt;n;i++){
		printf("%d ",arr[i]);
		if(i!=n-1)
			printf("");
	}
	printf("\n");
	return 0;
}
void quickSort(int arr[],int low,int high){
	if(low&lt;high){
		int pi=partition(arr,low,high);
		quickSort(arr,low,pi-1);
		quickSort(arr,pi+1,high);
	}
}
int partition(int arr[],int low,int high){
	int pivot=arr[high];
	int i=low-1;
	for(int j=low;j&lt;high;j++){
		if(arr[j]&lt;pivot){
			i++;
			int temp=arr[i];
			arr[i]=arr[j];
			arr[j]=temp;
		}
	}
	int temp=arr[i+1];
	arr[i+1]=arr[high];
	arr[high]=temp;
