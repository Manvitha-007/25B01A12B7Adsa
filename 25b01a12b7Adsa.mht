-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="615c52bf-f931-417d-a8f6-757f18ccefaf">If a solution exists, print an <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="3e77841d-5098-4b54-acfb-ae941000d88e" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="4ae743bb-1e97-4282-b408-700804eb1b24"><mjx-mi class="mjx-i" data-ref="2d956790-f125-4b97-b7c3-4ea6196c9e81"><mjx-c class="mjx-c1D441 TEX-I" data-ref="da3a48cd-7768-47a1-af02-47379066e859"></mjx-c></mjx-mi><mjx-mi class="mjx-i" data-ref="9d9b2b4b-5b8c-4bf5-a5dc-b3a5c9d09894"><mjx-c class="mjx-cD7" data-ref="e28f129f-c972-4731-b334-c8c3b43ceb81"></mjx-c></mjx-mi><mjx-mi class="mjx-i" data-ref="503b5208-6acb-4e32-a8c8-ab5559240321"><mjx-c class="mjx-c1D441 TEX-I" data-ref="29a9be48-ebac-4604-9e56-caa48a1b08b6"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="4b898c12-4cb9-4c35-9c9c-8db5d0fc4511"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="ef28ebd9-54a5-439a-bf7e-974ce066dbf0"><mi data-ref="8dff774a-6ec7-4696-89d8-9fcbbdcc64ed">N</mi><mi data-ref="e6ddf32c-e1e0-424f-b00e-603a738fae34">×</mi><mi data-ref="c1d21566-d5c1-4687-acfa-487e4cc6dc07">N</mi></math></mjx-assistive-mml></mjx-container> matrix consisting of 0s and 1s, where 1 represents a queen.</li><li data-ref="7d5528e8-d0e4-4d1a-bcf1-ebdfea5e376b">If no solution exists, print: "No solution exists for N = &lt;value&gt;".</li><li data-ref="64b691f4-a154-4b04-8aaa-de82a0deac0a">Each row of the matrix should be printed on a new line, with space-separated values.</li></ul><p data-ref="2817ac3e-f74d-4572-805b-494c79cecb5e" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="900d7f59-0be6-471e-abbb-cd7a081f249d"></p><p data-ref="5264a6ff-dde4-4a11-be29-bc3d7de23296" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="08f9518d-da5b-49b6-95f4-ca88eb12c610">Note:</strong> Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="ea4ef00a-a1d9-4568-96f4-b1c0463a1955"><div class="ml-1 mb-3" data-ref="732214d9-068f-487e-8810-925221a20cfe"><b style="border-bottom:1px solid black;" data-ref="ffe682f9-0ef6-45c3-bd40-5a639e726186" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="2fe801fb-64cc-492d-b278-b81ba9aa1439" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="42a4dec4-08a5-48cb-81c9-078ac0e20c93" data-undisplayed="undisplayed">nqueens.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="18ea5b5e-2bd8-4a87-b531-90909e32e01b" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#include&lt;stdbool.h&gt;
#define MAX 20
int board[MAX][MAX];

void printSolution(int n){
    for(int i=0;i&lt;n;i++){
        for(int j=0;j&lt;n;j++){
            printf("%d ",board[i][j]);
        }
        printf("\n");
    }
}

bool isSafe(int row,int col,int n){
    int i,j;
    for(i=0;i&lt;row;i++){
        if(board[i][col]==1)
            return false;
    }
    for(i=row,j=col;i&gt;=0 &amp;&amp; j&gt;=0;i--,j--){
        if(board[i][j]==1)
            return false;
    }
    for(i=row,j=col;i&gt;=0 &amp;&amp; j&lt;n;i--,j++){
        if(board[i][j]==1)
            return false;
    }
    return true;
}

bool solveNQueens(int row,int n){
    if(row==n)
        return true;
    for(int col=0;col&lt;n;col++){
        if(isSafe(row,col,n)){
            board[row][col]=1;
            if(solveNQueens(row+1,n)){
                return true;
            }
            board[row][col]=0;
        }
    }
    return false;
}

int main(){
    int N;
    scanf("%d",&amp;N);
    if(N&lt;=0 || N&gt;MAX){
        printf("Invalid board size, please use N between 1 and %d\n",MAX);
        return 0;
    }
    for(int i=0;i&lt;N;i++){
        for(int j=0;j&lt;N;j++){
            board[i][j]=0;
        }
    }
    if(solveNQueens(0,N)){
        printSolution(N);
    }
    else{
        printf("No solution exists for N = %d\n",N);
    }
