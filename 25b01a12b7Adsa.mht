int max(int a,int b){
	return (a&gt;b)?a:b;
}
int main(){
	int n,W;
	scanf("%d",&amp;n);
	int wt[n],val[n];
	for(int i=0;i&lt;n;i++){
		scanf("%d",&amp;wt[i]);
	}
	for(int i=0;i&lt;n;i++){
		scanf("%d",&amp;val[i]);
	}
	scanf("%d",&amp;W);
	int dp[n+1][W+1];
	for(int i=0;i&lt;=n;i++){
		for(int w=0;w&lt;=W;w++){
			if(i==0 || w==0)
				dp[i][w]=0;
			else if(wt[i-1]&lt;=w)
				dp[i][w]=max(dp[i-1][w],val[i-1]+dp[i-1][w-wt[i-1]]);
			else
				dp[i][w]=dp[i-1][w];
		}
	}
	printf("%d\n",dp[n][W]);
	return 0;
}</pre><br data-ref="222f561e-fb12-4196-a454-4978cf58627c"></div></div><div class="row" data-ref="c37f1d92-b15a-46bc-8b68-2170b01a3c7e"><div class="col-12" data-ref="0bf4ae90-cb86-4310-94c6-5fb7d065fe41"><h5 class="execResultsHeading text-center" data-ref="12d11606-bc37-4bbc-8d2a-8541724b6d93">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="7622b562-718a-43da-bcad-1f7f686364a1" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="e370b573-f9c1-4c32-9c86-39abce1f6509"><div class="row execution-results-border" data-ref="01576505-c2cd-442e-9ba4-be881247ec3e"><div class="col-12 p-2 text-center font-weight-bold" data-ref="ba704475-f92b-4fe2-afad-900a51fe076f">Test Case - 1</div></div><div class="row execution-results-border" data-ref="bb2497df-a7fb-4044-bf6c-7212de96e101"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="604aad69-0efc-4c79-ae0f-41d8e79464fc">User Output</div></div><div class="row execution-results-border" data-ref="10b5e54f-bef5-4688-ad1c-da9836f65e8c"><div class="col-6" data-ref="00a89787-57f5-4a8a-b0ac-f77a0748e925"><span class="cmd" title="User Input" data-ref="ae5b1bd7-f110-4c28-85eb-eb0fc591ea2d">5</span></div></div><div class="row execution-results-border" data-ref="d8a47afa-8d5c-4146-befd-1d281ebaea90"><div class="col-6" data-ref="fda7dbac-a843-4eef-acee-d7b209bd5d0e"><span class="cmd" title="User Input" data-ref="c8e36c4c-5967-42c1-8161-0aa60eab3833">5 10 15 20 25</span></div></div><div class="row execution-results-border" data-ref="d920e363-a667-48a3-84a6-16f2cfa35aa5"><div class="col-6" data-ref="d421e8c1-3a9d-4dde-bc5d-ae332eba7a7f"><span class="cmd" title="User Input" data-ref="86b9606d-a4a1-489d-a289-5830d631545f">10 20 30 40 50</span></div></div><div class="row execution-results-border" data-ref="175877ed-7f4d-4781-8e0c-a8497add3adb"><div class="col-6" data-ref="e8837082-566e-479e-aaaf-0306746c5f8d"><span class="cmd" title