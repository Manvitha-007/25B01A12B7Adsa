data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="5947abc6-96e0-4a3e-8e6c-61789c2ddb73">Note: </strong>Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="a0ec6123-218e-42cd-a495-a23acc1eb73a"><div class="ml-1 mb-3" data-ref="cb6a380b-4734-4d31-b42e-aa0c1f3345dc"><b style="border-bottom:1px solid black;" data-ref="c4766560-59c7-4260-b497-327165c86e26" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="7fc7864a-c76b-4f10-ab29-fa2679216fe7" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="057d2470-a92b-4070-88d2-5241a0723a77" data-undisplayed="undisplayed">BFS.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="8bd555e1-8075-4346-bdb8-9cc06ff8cc52" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#include&lt;stdlib.h&gt;
#define MAX 100
typedef struct Node {
int vertex;
struct Node*next;
} Node;
Node* adj[MAX];
int visited[MAX];
int queue[MAX];
int front=0,rear=0;
int n,e;
Node*createNode(int v){
Node* newNode=(Node*)malloc(sizeof(Node));
newNode-&gt;vertex=v;
newNode-&gt;next=NULL;
return newNode;
}
void enqueue(int v){
queue[rear++]=v;
}
int dequeue(){
return queue[front++];
}
void insertSorted(int u,int v){
Node*newNode=createNode(v);
if (adj[u]==NULL || adj[u]-&gt;vertex &gt; v){
newNode-&gt;next=adj[u];
adj[u]=newNode;
}else{
Node*current=adj[u];
while(current-&gt;next!=NULL&amp;&amp;current-&gt;next-&gt;vertex &lt; v)
{
current=current-&gt;next;
}
newNode-&gt;next=current-&gt;next;
current-&gt;next=newNode;
}
}
void BFS(int start){
int i;
Node*temp;
for (i=0;i&lt;n;i++)
visited[i]=0;
enqueue(start);
visited[start]=1;
while(front&lt;rear){
int current=dequeue();
printf("%d ",current);
temp=adj[current];
while(temp!=NULL){
if(!visited[temp-&gt;vertex]){
enqueue(temp-&gt;vertex);
visited[temp-&gt;vertex]=1;
}
temp=temp-&gt;next;
}
}
}
int main(){
int i,u,v,start;
scanf("%d %d",&amp;n,&amp;e);
for(i=0;i&lt;n;i++){
adj[i]=NULL;
}
for(i=0;i&lt;e;i++){
scanf("%d %d",&amp;u,&amp;v);
insertSorted(u,v);
}
scanf("%d",&amp;start);
BFS(start);
return 0;
}</pre><br data-ref="befcf925-632b-4d71-bdd9-b1f44c99786a"></div></div><div class="row" data-ref="f97c6668-f25c-4382-b6ce-e0613a367848"><div class="col-12" data-ref="24635ea8-65b4-4431-9649-fda6a4d09049"><h5 class="execResultsHeading text-center" data-ref="6340cd16-a6d9-4d0f-af17-bf4e590d6f4d">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="a5103637-bb1f-4371-9f9a-d96c8550cd2d" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="3f291c26-dc88-4bba-85a9-ba79c6f0e559"><div class="row execution-results-border" data-ref="e4059861-c2d7-4713-9402-0637f1023ab8"><div class="col-12 p-2 text-center font-weight-bold" data-ref="edc418e0-e9ea-4daa-85a2-1916aa760e39">Test Case - 1</div></div><div class="row execution-results-border" data-ref="2a1e8fb7-f5bf-4014-8ea9-602ddec0438b"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="eab0816e-5d33-404b-91dc-552d59bf2492">User Output</div></div><div class="row execution-results-border" data-ref="2a6e450c-1e80-47a4-9968-a768676fc805"><div class="col-6" data-ref="82229370-1c83-428d-b463-cff6ea67f25a"><span class="cmd" title="User Input" data-ref="46eccb01-ccf9-4f07-975a-302e1203be8f">5 4</span></div></div><div class="row execution-results-border" data-ref="bdb73c2a-ab3f-4d2b-a299-465e854f3024"><div class="col-6" data-ref="781a36d0-4fb3-4cb3-862a-654a6b2ba533"><span class="cmd" title="User Input" data-ref="cab27a3d-d40d-4f3f-9498-20227c363bf4">0 1</span></div></div><div class="row execution-results-border" data-ref="ca8255d9-b3f4-456c-b01f-060030896590"><div class="col-6" data-ref="2da836f6-f8a0-4ca1-8495-e82d59051ce3"><span class="cmd" title="User Input" data-ref="0f7bfeee-ba16-4185-9d53-2e83e5ec35ac">0 2</span></div></div><div class="row execution-results-border" data-ref="562085ab-ce1f-40f5-8a7c-1e64637d3129"><div class="col-6" data-ref="e837fb47-35c1-4450-a8ba-9742417bb566"><span class="cmd" title="User Input" data-