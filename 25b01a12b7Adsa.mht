int n;
int cost[MAX][MAX];
int dp[1 &lt;&lt; MAX][MAX];

int min(int a, int b) {
    return a &lt; b ? a : b;
}

int main() {
    scanf("%d", &amp;n);
    
    for (int i = 0; i &lt; n; i++) {
        for (int j = 0; j &lt; n; j++) {
            scanf("%d", &amp;cost[i][j]);
            if (cost[i][j] == -1) {
                cost[i][j] = INF;
            }
        }
    }

    if (n == 1) {
        printf("0");
        return 0;
    }

    int N = 1 &lt;&lt; n;
    
    // Initialize dp to INF
    for (int mask = 0; mask &lt; N; mask++) {
        for (int i = 0; i &lt; n; i++) {
            dp[mask][i] = INF;
        }
    }
    
    // Start at city 0
    dp[1][0] = 0;

    for (int mask = 1; mask &lt; N; mask++) {
        for (int u = 0; u &lt; n; u++) {
            if (!(mask &amp; (1 &lt;&lt; u))) continue;
            if (dp[mask][u] == INF) continue;
            
            for (int v = 0; v &lt; n; v++) {
                if (mask &amp; (1 &lt;&lt; v)) continue;
                if (cost[u][v] == INF) continue;
                
                int nextMask = mask | (1 &lt;&lt; v);
                if (dp[nextMask][v] &gt; dp[mask][u] + cost[u][v]) {
                    dp[nextMask][v] = dp[mask][u] + cost[u][v];
                }
            }
        }
    }

    int fullMask = N - 1;
    int ans = INF;
    
    for (int i = 1; i &lt; n; i++) {
        if (cost[i][0] != INF &amp;&amp; dp[fullMask][i] != INF) {
            ans = min(ans, dp[fullMask][i] + cost[i][0]);
        }
    }

    // If no tour exists
    if (ans == INF) {
        printf("-1");
    } else {
        printf("%d", ans);
    }

    return 0;
}</pre><br data-ref="840ad7d1-dfec-4c28-a4c5-0790cc67cdca"></div></div><div class="row" data-ref="1d45f8da-eded-42fe-b70d-b7664c9be90b"><div class="col-12" data-ref="b84b840c-ac5c-4a00-a83d-11ce1f8853e9"><h5 class="execResultsHeading text-center" data-ref="56046d1b-e439-4d1a-b2a9-74d1842a352f">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="a50ee5bb-3fc8-4be7-891e-21258dd8da2c" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="05d19f80-c4fa-4d94-84a0-30bb40cfba83"><div class="row execution-results-border" data-ref="db5286b6-0602-4956-954c-2fd80163234a"><div class="col-12 p-2 text-center font-weight-bold" data-ref="ebf6b249-da9b-4488-b7cb-62782efc7cdc">Test Case - 1</div></div><div class="row execution-results-border" data-ref="3f39d4c0-138c-434e-945e-0cfc2e8dec86"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="02065d4e-7035-4867-93a1-234110a89c04">User Output</div></div><div class="row execution-results-border" data-ref="3f8da6f9-6faf-427e-9c97-111a617d6be4"><div class="col-6" data-ref="6f076b2e-a6f0-4462-a549-e0de1de5537b"><span class="cmd" title="User Input" data-ref="b90c63fe-523a-45a0-8a22-acd096f921e6">3</span></div></div><div class="row execution-results-border" data-ref="713128cd-5f20-4181-bc9f-59cf6d286605"><div class="col-6" data-ref="3c4697ae-b58f-410b-b0d1-829782cbbd20"><span class="cmd" title="User Input" data-ref="d15d7ec5-8ca6-430b-bf01-b26a6413ea40">-1 2 3</span></div></div><div class="row execution-results-border" data-ref="b673ed55-ff48-433e-9631-da6338c7e278"><div class="col-6" data-ref="607795fe-8c93-41d7-92c9-beda6a62b2e5"><span class="cmd" title="User Input" data-ref="ddbd82d9-7cf4-4892-a053-dd02818cfb61">4 -1 6</span></div></div><div class="row execution-results-border" data-ref="93478ec6-2577-41c7-beef-79b6620b7c90"><div class="col-6" data-ref="844bb262-dcc9-4e54-979a-5aeb79df6415"><span class="cmd" title="User Input" d