g order.</li></ul></span></div><div class="mb-3" data-ref="692dbb1a-3e23-4931-a2fb-bf523631c2cf"><div class="ml-1 mb-3" data-ref="8cdb4824-c9dd-4f89-bf71-2d86a799c8b1"><b style="border-bottom:1px solid black;" data-ref="4232af2b-17ee-4ffb-b650-715180873885" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="f391433e-dd69-4e28-a5f5-7c5de860c0d1" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="c4dbd08f-a107-4711-bf9e-93b217f59fe2" data-undisplayed="undisplayed">CTC64721.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="949cad10-715a-48f8-b058-51f195228fc8" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#define MAX 100
int adj[MAX][MAX]; //Adjacency matrix
int visited[MAX]; //Visited array
int queue[MAX]; //Queue for BFS
int front = 0, rear = 0;
int n; //Number of vertices
// Enqueue operation
void enqueue(int v) {
    queue[rear++] = v;
}
//Dequeue operation
int dequeue() {
    return queue[front++];
}
// Check if queue is empty
int isEmpty() {
    return front == rear;
}
// BFS function
void BFS(int start){
    int i, current;
    visited[start] = 1;
    enqueue(start);
    while(!isEmpty()) {
        current = dequeue();
        printf("%d ", current);
        // Visit all adjacent vertices in increasing order
        for(i = 0; i &lt; n; i++){
            if (adj[current][i] == 1 &amp;&amp; !visited[i]) {
                visited[i] = 1;
                enqueue(i);
            }
        }
    }
}
int main(){
    int edges, i, j, u, v, start;
    scanf("%d", &amp;n); //Number of vertices
    scanf("%d", &amp;edges); //Number of edges
    // Initialize adjacency matrix and visited array
    for (i = 0; i &lt; n; i++) {
        visited[i] = 0;
        for(j = 0; j &lt; n; j++) {
            adj[i][j] = 0;
        }
    }
    //Read edges
    for (i = 0; i &lt; edges; i++) {
        scanf("%d %d", &amp;u, &amp;v);
        adj[u][v] = 1;
        adj[v][u] = 1;
    }
    scanf("%d", &amp;start);
    BFS(start);
    return 0;
}</pre><br data-ref="336e3887-4d0d-4000-b617-0c7cdc8d5a5a"></div></div><div class="row" data-ref="1e4e8989-d134-48d4-a133-278306af5b60"><div class="col-12" data-ref="5a8bb233-5c10-4729-9cb6-ce7426a2154f"><h5 class="execResultsHeading text-center" data-ref="7ac45720-e76c-4006-b7e9-fc95a3a4e56f">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="77b80916-ea8b-4849-90e6-dd6d6e19135c" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="0317a49c-f87a-4646-97d3-21c0c7f764a4"><div class="row execution-results-border" data-ref="9f402d0d-e0b5-4c8a-a816-a991c8a186c6"><div class="col-12 p-2 text-center font-weight-bold" data-ref="83417cac-0aa4-43f4-9e5e-58302088c2f1">Test Case - 1</div></div><div class="row execution-results-border" data-ref="b2507f84-8eaf-4122-8de2-ef953c874a02"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="ed02632e-9fd3-4638-9420-1bbdb881a13d">User Output</div></div><div class="row execution-results-border" data-ref="521f58a9-5cce-4236-8bdc-4a16ae784945"><div class="col-6" data-ref="dc44d19a-b1f4-4428-86f9-ad59a8f23bae"><span class="cmd" title="User Input" data-ref="4c96ed31-4a20-41c5-8915-242348d52feb">4</span></div></div><div class="row execution-results-border" data-ref="ee4a2c05-abbd-4b45-ae7a-fec346af156b"><div class="col-6" data-ref="e6ac7008-638e-4a4b-bfb2-7c2ae2b6105d"><span class="cmd" title="User Input" data-ref="dcb25929-a3f6-41af-ab91-6b3f48016fa3">4</span></div></div><div class="row execution-results-border" data-ref="c52202ca-0a2c-48d7-88d8-bad140a664c2"><div class="col-6" data-ref="0de1ba37-b5a2-4bb8-b092-e2ce38d227cf"><span class="cmd" title="User Input" data-ref="7fcab493-0cbf-4a7a-9d39-72117c51227f">0 1</span></div></div><div class="row execution-results-border" data-ref="bdf3016c-68bb-4e2d-b5c6-e3735a8d7af0"><div class="col-6" data-ref="e5e6ce5f-6e5f-4074-8940-999c76695ba5"><span class="cmd" title="User Input" data-ref=